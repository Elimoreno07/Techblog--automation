# Copy this file to .env for local use. Never commit .env.
# All values below are deliberately empty or fictitious.

# Optional defaults. The script parameters take precedence.
TECHBLOG_SITE_URL=https://contoso.sharepoint.com/sites/department/TechBlog
TECHBLOG_LIST=Posts
TECHBLOG_BASE_POST_URL=https://contoso.sharepoint.com/sites/department/TechBlog/Lists/Posts/Post.aspx?ID=123

# PnP PowerShell authentication: Interactive, DeviceLogin or Certificate.
TECHBLOG_AUTH_MODE=Interactive

# Required for Interactive, DeviceLogin and Certificate modes.
# Put the real value only in your local .env or process environment.
ENTRAID_APP_ID=

# Required only for Certificate mode.
ENTRAID_TENANT_ID=
ENTRAID_CERTIFICATE_PATH=
ENTRAID_CERTIFICATE_PASSWORD=

# Internal field names. Change only if the target list uses different names.
TECHBLOG_TITLE_FIELD=Title
TECHBLOG_BODY_FIELD=Body
TECHBLOG_DATE_FIELD=PublishedDate
